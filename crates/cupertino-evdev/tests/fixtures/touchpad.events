# Clickpad, two fingers: touch down, second finger, move, lift (slot 0 first), lift (slot 1), then slot 0 reused by
# a new touch with a click. ABS_MT_SLOT 0x2f, TOUCH_MAJOR 0x30, TOUCH_MINOR 0x31, POSITION_X 0x35, POSITION_Y 0x36,
# TOOL_TYPE 0x37, TRACKING_ID 0x39, PRESSURE 0x3a. BTN_TOUCH 330, BTN_TOOL_FINGER 325, BTN_TOOL_DOUBLETAP 333.
# The kernel omits ABS_MT_SLOT while the slot is unchanged (it starts at 0).
3000.000000 3 57 100     # slot 0: tracking id 100
3000.000000 3 53 1200
3000.000000 3 54 800
3000.000000 3 58 40
3000.000000 3 48 300
3000.000000 3 49 250
3000.000000 3 55 0       # MT_TOOL_FINGER
3000.000000 3 0 1200     # ABS_X
3000.000000 3 1 800      # ABS_Y
3000.000000 1 330 1      # BTN_TOUCH
3000.000000 1 325 1      # BTN_TOOL_FINGER
3000.000000 0 0 0
3000.012000 3 47 1       # slot 1
3000.012000 3 57 101
3000.012000 3 53 2500
3000.012000 3 54 820
3000.012000 3 58 38
3000.012000 3 48 280
3000.012000 3 49 240
3000.012000 3 55 0
3000.012000 1 325 0
3000.012000 1 333 1      # BTN_TOOL_DOUBLETAP
3000.012000 0 0 0
3000.024000 3 47 0
3000.024000 3 53 1230    # slot 0 x
3000.024000 3 0 1230
3000.024000 3 47 1
3000.024000 3 54 830     # slot 1 y
3000.024000 0 0 0
3000.036000 3 47 0
3000.036000 3 57 -1      # slot 0 lifts
3000.036000 1 333 0
3000.036000 1 325 1
3000.036000 0 0 0
3000.048000 3 47 1
3000.048000 3 57 -1      # slot 1 lifts
3000.048000 1 330 0
3000.048000 1 325 0
3000.048000 0 0 0
3000.500000 3 47 0
3000.500000 3 57 102     # new touch reuses slot 0
3000.500000 3 53 600
3000.500000 3 54 400
3000.500000 3 58 35
3000.500000 3 48 200
3000.500000 3 49 190
3000.500000 3 55 0
3000.500000 3 0 600
3000.500000 3 1 400
3000.500000 1 330 1
3000.500000 1 325 1
3000.500000 4 4 90001    # MSC_SCAN
3000.500000 1 272 1      # BTN_LEFT: the physical click
3000.500000 0 0 0
3000.620000 4 4 90001
3000.620000 1 272 0
3000.620000 0 0 0
