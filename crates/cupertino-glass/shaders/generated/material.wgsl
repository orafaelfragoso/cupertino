// The shared module: the drawing maths of cupertino_raster_math in WGSL, concatenated ahead of every program by the
// build step (cupertino-gpu-shaders). Each function computes what its namesake there computes, in f32, and the
// crate's tests check the generated programs against that crate's vectors.
//
// Conventions of every program: clip y = -1 is a target's first row (the top of an image handed on), texture
// coordinate v = 0 is a texture's first row, and the fragment position counts pixels from the first row and column.
// Uniform blocks only, std140 layout, no 2 x 2 matrices in them.

// Exponents up to this are circular corners.
const CIRCULAR_EXPONENT: f32 = 2.001;
// Midpoint steps of a shadow's integral across y.
const SHADOW_STEPS: i32 = 8;
// Most stops a gradient has.
const MAX_STOPS: i32 = 8;

// A triangle that covers the whole target from the vertex index alone (0, 1, 2).

// Signed distance from p (relative to the centre) to the rounded rectangle of half size `half`, corner extent `e`
// and corner exponent `n`: circular corners up to CIRCULAR_EXPONENT, the closed-form first-order distance of the
// superellipse above it, held at least at the bounding-box distance.


// Coverage of a pixel whose centre lies at signed distance d from an outline, at px pixels per unit.

// Coverage of a stroke of `width` inside the outline.

// The error function, four-term rational approximation.

// The normal density of deviation sigma at x.

// The blurred box across x at height y, its half width curved by a circular corner.

// The Gaussian blur of a rounded box at p relative to its centre: the blurred silhouette's coverage.

// What rounded_box_blur reaches deep inside a box.

// A rounded-rectangle caster: half size, corner radius of the blurred box, extent and exponent of its outline.
struct Caster {
    half: vec2<f32>,
    radius: f32,
    extent: f32,
    exponent: f32,
}

// A shadow: deviation, offset and density.
struct Shadow {
    sigma: f32,
    offset: vec2<f32>,
    density: f32,
}

// Alpha of a drop shadow at p; with `cut_out` the caster's own area is left clear.

// Alpha of an inner shadow at p.

// The premultiplied colour at t of `count` stops (offsets packed four to a vector, straight encoded sRGB colours).

// The 2 x 2 ordered matrix at bit k of a pixel's position.
fn dither_pair(p: vec2<u32>, k: u32) -> u32 {
    let a = (p.x >> k) & 1u;
    let b = (p.y >> k) & 1u;
    return 2u * (a ^ b) + b;
}

// The 8 x 8 ordered matrix entry, 0 to 63, of the pixel whose centre is `frag`.
fn dither_matrix(frag: vec2<f32>) -> u32 {
    let p = vec2<u32>(floor(frag));
    return 16u * dither_pair(p, 0u) + 4u * dither_pair(p, 1u) + dither_pair(p, 2u);
}

// The offset of the pixel whose centre is `frag`, in 8-bit steps, inside (-0.5, 0.5).
fn dither_offset(frag: vec2<f32>) -> f32 {
    return (f32(dither_matrix(frag)) + 0.5) / 64.0 - 0.5;
}

// v with its pixel's offset added, before an 8-bit store.

fn dither_rgb(c: vec3<f32>, frag: vec2<f32>) -> vec3<f32> {
    return c + vec3<f32>(dither_offset(frag) / 255.0);
}

// ---- material.wgsl ----
// Material region: a rounded mask from a signed distance field, the backdrop as the base colour, then the recipe's
// fill layers with their compositing filters. Blend with (SRC_ALPHA, ONE_MINUS_SRC_ALPHA) for colour and (ZERO, ONE)
// for alpha.
//
// The backdrop is always bound (a recipe without a backdrop filter reads an unfiltered copy of the target) and shares
// the target's orientation; it may cover only part of the target, the part around the region it was made for:
// Region.info.zw is its origin and Region.sizes.zw its size, in target pixels.

// ---- place.wgsl ----
// Where a region program (material, glass) draws: one quad per damage rectangle, mapped through the frame's
// projection so the output's transform is honoured, and whether the result is dithered by pixel before an 8-bit
// store. Drawn as a 4-vertex triangle strip; lengths are target pixels, y down.

// Uniform block of the placement (std140, mirrored by `Placement` in ops.rs).
//   proj  = the frame's projection from target pixels to clip space, column-major
//   quad  = x, y, w, h of the quad drawn, in target pixels
//   flags = (dither the result by its pixel: 1, 0, 0, 0)
struct Placement {
  proj: mat3x3<f32>,
  quad: vec4<f32>,
  flags: vec4<i32>,
};

@group(1) @binding(0) var<uniform> place: Placement;

struct VsOut {
  @builtin(position) pos: vec4<f32>,
  // the target pixel, y down
  @location(0) px: vec2<f32>,
  // the framebuffer-normalised coordinate of the same point
  @location(1) uv: vec2<f32>,
};

@vertex
fn vs_main(@builtin(vertex_index) i: u32) -> VsOut {
  let corner = vec2<f32>(f32(i & 1u), f32((i >> 1u) & 1u));
  let p = place.quad.xy + corner * place.quad.zw;
  let c = place.proj * vec3<f32>(p, 1.0);
  var o: VsOut;
  o.pos = vec4<f32>(c.xy, 0.0, 1.0);
  o.px = p;
  o.uv = c.xy * 0.5 + vec2<f32>(0.5);
  return o;
}

// `c` dithered by its pixel when the placement asks for it.
fn placed(c: vec4<f32>, frag: vec2<f32>) -> vec4<f32> {
  if (place.flags.x != 0) {
    return vec4<f32>(dither_rgb(c.rgb, frag), c.a);
  }
  return c;
}

// Uniform block of the region (std140, mirrored by `RegionParams` in ops.rs).
struct Region {
  rect: vec4<f32>,      // x, y, w, h in target pixels (y down)
  shape: vec4<f32>,     // corner extent (px), superellipse exponent, opacity, antialiasing width (px)
  info: vec4<f32>,      // number of fill layers, 1, the backdrop's origin x, y
  sizes: vec4<f32>,     // target w, h, the backdrop's w, h
  tint: vec4<f32>,      // tint layer colour (rgb)
  fills: array<vec4<f32>, 16>,  // per fill: (blend id, tint flag, 0, 0), straight rgba
};

@group(0) @binding(0) var<uniform> R: Region;
@group(0) @binding(1) var backdrop: texture_2d<f32>;
@group(0) @binding(2) var samp: sampler;

// Signed distance (negative inside) to a rounded rectangle centred at the origin with half extents `hs`. `e` is the
// corner extent; `n` the superellipse exponent (2 = circular). Same formula as
// cupertino_geometry::RoundedRect::sdf_approx.
fn region_sdf(p: vec2<f32>, hs: vec2<f32>, e: f32, n: f32) -> f32 {
  let q = abs(p) - (hs - vec2<f32>(e));
  if (q.x <= 0.0 && q.y <= 0.0) { return max(q.x, q.y) - e; }
  if (q.x <= 0.0) { return q.y - e; }
  if (q.y <= 0.0) { return q.x - e; }
  if (e <= 0.0) { return length(q); }
  if (n <= 2.001) { return length(q) - e; }
  let u = max(q.x / e, 1e-6);
  let v = max(q.y / e, 1e-6);
  let g = pow(pow(u, n) + pow(v, n), 1.0 / n);
  let grad = sqrt(pow(u, 2.0 * n - 2.0) + pow(v, 2.0 * n - 2.0)) / pow(g, n - 1.0);
  let d = (g - 1.0) / grad * e;
  return max(d, max(q.x, q.y) - e);
}

fn soft_light(s: f32, d: f32) -> f32 {   // W3C compositing definition
  if (s <= 0.5) { return d - (1.0 - 2.0 * s) * d * (1.0 - d); }
  var g: f32;
  if (d <= 0.25) { g = ((16.0 * d - 12.0) * d + 4.0) * d; } else { g = sqrt(d); }
  return d + (2.0 * s - 1.0) * (g - d);
}

// d is opaque; s = straight source colour, a = source alpha.
// Blend ids: 0 normal, 1 plus-lighter, 2 plus-darker, 3 darken, 4 lighten, 5 soft-light, 6 copy.
fn blend(mode: i32, s: vec3<f32>, a: f32, d: vec3<f32>) -> vec3<f32> {
  var b: vec3<f32>;
  switch mode {
    case 1: { b = min(vec3<f32>(1.0), s + d); }
    case 2: { b = max(vec3<f32>(0.0), s + d - vec3<f32>(1.0)); }
    case 3: { b = min(s, d); }
    case 4: { b = max(s, d); }
    case 5: { b = vec3<f32>(soft_light(s.r, d.r), soft_light(s.g, d.g), soft_light(s.b, d.b)); }
    case 6: { return s * a; }
    default: { b = s; }
  }
  return d * (1.0 - a) + b * a;
}

@fragment
fn fs_main(fin: VsOut) -> @location(0) vec4<f32> {
  let hs = R.rect.zw * 0.5;
  let d = region_sdf(fin.px - (R.rect.xy + hs), hs, R.shape.x, R.shape.y);
  let cov = clamp(0.5 - d / R.shape.w, 0.0, 1.0) * R.shape.z;
  if (cov <= 0.0) { discard; }
  let uv = (fin.uv * R.sizes.xy - R.info.zw) / R.sizes.zw;
  var base = textureSampleLevel(backdrop, samp, uv, 0.0).rgb;
  let n = i32(R.info.x);
  for (var i = 0; i < n; i++) {
    let a = R.fills[2 * i];
    let b = R.fills[2 * i + 1];
    var s = b.xyz;
    if (a.y > 0.5) { s = R.tint.rgb; }
    base = blend(i32(a.x), s, b.w, base);
  }
  return placed(vec4<f32>(clamp(base, vec3<f32>(0.0), vec3<f32>(1.0)), cov), fin.pos.xy);
}
