// cupertino-layers --graph
// 76 crates, 392 internal dependencies
// per layer: foundation 5, graphics 2, models 6, system 8, platform 2, protocol 3, transport 2, render 3, ui 9, shellkit 1, core 4, services 7, shell 15, apps 2, tools 6, testing 1
// forbidden normal edge cupertino-settings (apps) -> cupertino-wayland-client (transport)
digraph "layers" {
  node [shape=box];
  subgraph "cluster_foundation" {
    label="foundation (5)";
    "cupertino-animation";
    "cupertino-geometry";
