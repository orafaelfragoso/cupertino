// cupertino-layers --graph target
// 55 crates, 203 internal dependencies
// per layer: foundation 11, models 7, platform 7, protocol 3, transport 3, render 4, ui 2, core 1, shell 9, services 4, apps 2, tools 2
// forbidden normal edge cupertino-files (apps) -> cupertino-decorations (render), migration #46 exception (apps): apps paint fields, shapes, text and system icons with desktop render crates until they draw through the toolkit (WP-10)
// forbidden normal edge cupertino-files (apps) -> cupertino-icons (render), migration #46 exception (apps): apps paint fields, shapes, text and system icons with desktop render crates until they draw through the toolkit (WP-10)
// forbidden dev edge cupertino-server (core) -> cupertino-client (ui), permanent exception (compositor): server integration tests connect real shell clients
// forbidden normal edge cupertino-settings (apps) -> cupertino-alsa (platform), migration #21 exception (services): the sound pane drives the mixer itself until audio goes through a service
// forbidden normal edge cupertino-settings (apps) -> cupertino-decorations (render), migration #46 exception (apps): apps paint fields, shapes, text and system icons with desktop render crates until they draw through the toolkit (WP-10)
// forbidden normal edge cupertino-settings (apps) -> cupertino-icons (render), migration #46 exception (apps): apps paint fields, shapes, text and system icons with desktop render crates until they draw through the toolkit (WP-10)
// forbidden normal edge cupertino-text-field (foundation) -> cupertino-keyboard (models), migration #47 exception (design): the text field takes its editing bindings from the compositor keyboard model until the toolkit text crate owns them (Phase 3, WP-07)
// denied paths ui -> core, shell, services: none
digraph "target" {
  node [shape=box];
  subgraph "cluster_foundation" {
    label="foundation (11)";
    "cupertino-animation";
    "cupertino-apps";
    "cupertino-assets";
    "cupertino-defaults";
    "cupertino-filepicker";
    "cupertino-geometry";
    "cupertino-text-field";
