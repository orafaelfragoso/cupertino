pkgbase = cupertino-git
	pkgdesc = Wayland desktop shell and compositor
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/orafaelfragoso/cupertino
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = dbus
	makedepends = git
	makedepends = cargo
	makedepends = python
	makedepends = mesa
	makedepends = libglvnd
	makedepends = pam
	provides = cupertino
	conflicts = cupertino
	options = !lto
	source = cupertino::git+https://github.com/orafaelfragoso/cupertino.git
	sha256sums = SKIP

pkgname = cupertino-git
	depends = glibc
	depends = gcc-libs
	depends = mesa
	depends = libglvnd
	depends = pam
	depends = systemd
	depends = dbus
	depends = xkeyboard-config
	depends = cupertino-data
	optdepends = wayland: nested session inside another Wayland desktop
	optdepends = libxkbcommon: nested session
	optdepends = foot: terminal for the nested try-out
	optdepends = iwd: wireless backend when cupertino-netd is enabled
	backup = etc/cupertino/login.conf
	backup = etc/cupertino/greeter.json
	backup = etc/pam.d/cupertino-login
	backup = etc/pam.d/cupertino-session
	backup = etc/pam.d/cupertino-greeter
	backup = etc/pam.d/cupertino-autologin
