# Maintainer: Rafael Fragoso <rafaelfragosom@gmail.com>
# Development recipe: the runtime and the C SDK from the latest commit; the asset pack comes from the stable
# cupertino-data.
pkgbase=cupertino-git
pkgname=('cupertino-git' 'cupertino-kit-git')
pkgver=0.1.0 # replaced by pkgver()
pkgrel=1
pkgdesc='Wayland desktop shell and compositor'
arch=('x86_64')
url='https://github.com/orafaelfragoso/cupertino'
license=('GPL-3.0-or-later' 'MPL-2.0' 'MIT' 'OFL-1.1' 'LGPL-2.1-or-later' 'MIT-CMU' 'BSD-3-Clause')
makedepends=('git' 'cargo' 'python' 'mesa' 'libglvnd' 'pam' 'gcc-libs' 'systemd' 'dbus' 'xkeyboard-config' 'shared-mime-info' 'adwaita-icon-theme' 'clang' 'libpipewire')
checkdepends=('cargo-nextest>=0.9.151')
# makepkg's LTO flags would reach the C code of build dependencies only; the release profile decides for Rust. No
# split debug package: it is ~0.9 GB of debug info for the sixteen binaries.
# The manual pages ship as release.py's manifest names them (usr/share/man/man1/*.1), uncompressed.
options=('!lto' '!debug' '!zipman')
source=("cupertino::git+$url.git")
sha256sums=('SKIP')

# Fails without a v* tag in the history: the version is the last release plus the commits since.
pkgver() {
  cd cupertino
  git describe --long --tags --match 'v[0-9]*' | sed -e 's/^v//' -e 's/-rc/rc/' -e 's/-/.r/' -e 's/-/./g'
}

prepare() {
  cd cupertino
  cargo fetch --locked
}

# Build and check share compiler inputs even when makepkg carries exported flags between functions.
build_environment() {
  # The packaged binaries are stripped; keep test compilation on the same release settings.
  export CARGO_INCREMENTAL=0 CARGO_PROFILE_RELEASE_DEBUG=0 CUPERTINO_THEME_DIR=/usr/share/cupertino/theme
  local remap target_dir
  target_dir=$(realpath -m "${CARGO_TARGET_DIR:-target}")
  for remap in "--remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase" \
               "--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo" \
               "--remap-path-prefix=$target_dir=/usr/src/debug/$pkgbase/target"; do
    case " ${RUSTFLAGS:-} " in
      *" $remap "*) ;;
      *) RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$remap" ;;
    esac
  done
  export RUSTFLAGS
}

build() {
  cd cupertino
  build_environment
  cargo build --frozen --release --workspace --all-features --bins
  # libcupertinokit.so, the C SDK's library: the cdylib of cupertino-ui-abi, which no binary links
  cargo build --frozen --release -p cupertino-ui-abi --lib --all-features
  # The manual pages and the completions of the cupertino command, written by the binary just built from its registry;
  # the pages are dated by makepkg's SOURCE_DATE_EPOCH. MANIFEST names what was written.
  local cli="${CARGO_TARGET_DIR:-target}/release/cupertino" gen="$srcdir/gen" shell
  rm -rf "$gen"
  "$cli" dev manual "$gen/man" >/dev/null
  install -d "$gen/completions"
  for shell in bash zsh fish; do
    "$cli" completions "$shell" > "$gen/completions/$shell"
  done
  (cd "$gen" && find . -type f ! -name MANIFEST -printf '%P\n' | LC_ALL=C sort > MANIFEST)
}

check() {
  cd cupertino
  build_environment
  export CUPERTINO_SPEC_DIR="$PWD/data/theme"
  # The compositor tests open a Wayland socket; the build environment has no runtime directory of its own.
  export XDG_RUNTIME_DIR="$srcdir/runtime"
  install -d -m 700 "$XDG_RUNTIME_DIR"
  dbus-run-session -- python3 ci/build-test-fixtures.py --frozen --release -- cargo nextest run --frozen --release --workspace --all-features
  cargo test --frozen --release --workspace --all-features --doc
}

package_cupertino-git() {
  provides=('cupertino')
  conflicts=('cupertino')
  depends=('glibc' 'sh' 'gcc-libs' 'mesa' 'libglvnd' 'pam' 'systemd' 'dbus>=1.16' 'polkit' 'gnome-keyring' 'libsecret' 'pipewire>=1:1.4' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'xkeyboard-config' 'shared-mime-info' 'adwaita-icon-theme' 'cupertino-data')
  optdepends=('wayland: nested session inside another Wayland desktop'
              'libxkbcommon: nested session'
              'foot: terminal for the nested try-out'
              'iwd: wireless backend when cupertino-netd is enabled'
              'xwayland-satellite>=0.8: X11 app support'
              'xorg-xwayland: X11 app support')
  backup=('etc/cupertino/login.conf' 'etc/cupertino/greeter.json' 'etc/cupertino/compositor.json'
          'etc/pam.d/cupertino-login' 'etc/pam.d/cupertino-session'
          'etc/pam.d/cupertino-greeter' 'etc/pam.d/cupertino-autologin')
  cd cupertino
  python3 packaging/release.py install --format arch --package runtime --destdir "$pkgdir" --bindir "${CARGO_TARGET_DIR:-target}/release" \
    --gendir "$srcdir/gen"
}

# The C SDK: libcupertinokit.so.1 with its soname links, header and pkg-config file (release.py's sdk manifest). It
# links the toolkit statically and the C and GCC runtimes dynamically; the theme and the asset pack are read at run time
# when installed, else the toolkit uses its built-in fallbacks.
package_cupertino-kit-git() {
  pkgdesc='CupertinoKit C SDK: the libcupertinokit shared library, its header and pkg-config file'
  license=('MPL-2.0' 'MIT' 'OFL-1.1')
  depends=('glibc' 'gcc-libs')
  optdepends=('cupertino-data: the fonts and icons of the desktop'
              'cupertino: the desktop theme')
  provides=('cupertino-kit' 'libcupertinokit.so')
  conflicts=('cupertino-kit')
  cd cupertino
  python3 packaging/release.py install --format arch --package sdk --destdir "$pkgdir" --bindir "${CARGO_TARGET_DIR:-target}/release"
}
