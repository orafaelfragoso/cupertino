pkgbase = cupertino
	pkgdesc = Wayland desktop shell and compositor
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/orafaelfragoso/cupertino
	arch = x86_64
	license = GPL-3.0-or-later
	license = MPL-2.0
	license = MIT
	license = OFL-1.1
	license = LGPL-2.1-or-later
	license = MIT-CMU
	license = BSD-3-Clause
	makedepends = cargo
	makedepends = python
	makedepends = mesa
	makedepends = libglvnd
	makedepends = pam
	makedepends = gcc-libs
	makedepends = systemd
	makedepends = dbus
	makedepends = xkeyboard-config
	makedepends = shared-mime-info
	makedepends = adwaita-icon-theme
	options = !lto
	options = !debug
	source = https://github.com/orafaelfragoso/cupertino/releases/download/v0.1.0/cupertino-0.1.0-source.tar.xz
	sha256sums = UNRELEASED

pkgname = cupertino
	depends = glibc
	depends = sh
	depends = gcc-libs
	depends = mesa
	depends = libglvnd
	depends = pam
	depends = systemd
	depends = dbus
	depends = xkeyboard-config
	depends = shared-mime-info
	depends = adwaita-icon-theme
	depends = cupertino-data>=0.1.0
	optdepends = wayland: nested session inside another Wayland desktop
	optdepends = libxkbcommon: nested session
	optdepends = foot: terminal for the nested try-out
	optdepends = iwd: wireless backend when cupertino-netd is enabled
	optdepends = xwayland-satellite>=0.8: X11 app support
	optdepends = xorg-xwayland: X11 app support
	backup = etc/cupertino/login.conf
	backup = etc/cupertino/greeter.json
	backup = etc/cupertino/compositor.json
	backup = etc/pam.d/cupertino-login
	backup = etc/pam.d/cupertino-session
	backup = etc/pam.d/cupertino-greeter
	backup = etc/pam.d/cupertino-autologin

pkgname = cupertino-data
	pkgdesc = Default asset pack of Cupertino: original icons, Inter and six Unsplash wallpapers
	arch = any
	license = GPL-3.0-or-later
	license = OFL-1.1
	license = LicenseRef-Unsplash
	depends = adwaita-icon-theme
