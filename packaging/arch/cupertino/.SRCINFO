pkgbase = cupertino
	pkgdesc = Wayland desktop shell and compositor
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/orafaelfragoso/cupertino
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = dbus
	checkdepends = xkeyboard-config
	checkdepends = shared-mime-info
	makedepends = cargo
	makedepends = python
	makedepends = mesa
	makedepends = libglvnd
	makedepends = pam
	options = !lto
	source = https://github.com/orafaelfragoso/cupertino/releases/download/v0.1.0/cupertino-0.1.0-source.tar.xz
	sha256sums = UNRELEASED

pkgname = cupertino
	depends = glibc
	depends = gcc-libs
	depends = mesa
	depends = libglvnd
	depends = pam
	depends = systemd
	depends = dbus
	depends = xkeyboard-config
	depends = shared-mime-info
	depends = cupertino-data>=0.1.0
	optdepends = wayland: nested session inside another Wayland desktop
	optdepends = libxkbcommon: nested session
	optdepends = foot: terminal for the nested try-out
	optdepends = iwd: wireless backend when cupertino-netd is enabled
	backup = etc/cupertino/login.conf
	backup = etc/cupertino/greeter.json
	backup = etc/pam.d/cupertino-login
	backup = etc/pam.d/cupertino-session
	backup = etc/pam.d/cupertino-greeter
	backup = etc/pam.d/cupertino-autologin

pkgname = cupertino-data
	pkgdesc = Default asset pack of Cupertino: Inter, the icon map and six Unsplash wallpapers
	arch = any
	license = GPL-3.0-or-later
	license = OFL-1.1
	license = LicenseRef-Unsplash
	depends = 
	optdepends = adwaita-icon-theme: the host icons the icon map names
