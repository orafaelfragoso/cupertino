# Maintainer: Rafael Fragoso <rafaelfragosom@gmail.com>
# Stable recipe: the runtime and the default asset pack from one release source archive.
pkgbase=cupertino
pkgname=('cupertino' 'cupertino-data')
pkgver=0.1.0
pkgrel=1
pkgdesc='Wayland desktop shell and compositor'
arch=('x86_64')
url='https://github.com/orafaelfragoso/cupertino'
license=('GPL-3.0-or-later' 'MPL-2.0' 'MIT' 'OFL-1.1' 'LGPL-2.1-or-later' 'MIT-CMU' 'BSD-3-Clause')
makedepends=('cargo' 'python' 'mesa' 'libglvnd' 'pam' 'gcc-libs' 'systemd' 'dbus' 'xkeyboard-config' 'shared-mime-info' 'adwaita-icon-theme' 'clang' 'libpipewire')
checkdepends=('cargo-nextest>=0.9.151' 'git')
# makepkg's LTO flags would reach the C code of build dependencies only; the release profile decides for Rust. No
# split debug package: it is ~0.9 GB of debug info for the sixteen binaries.
options=('!lto' '!debug')
_tag=v$pkgver
source=("$url/releases/download/$_tag/cupertino-$pkgver-source.tar.xz")
# Written by the release; an unreleased version has no checksum and must not build from a download.
sha256sums=('UNRELEASED')

prepare() {
  cd "cupertino-$pkgver"
  cargo fetch --locked
}

# Build and check share compiler inputs even when makepkg carries exported flags between functions.
build_environment() {
  # The packaged binaries are stripped; keep test compilation on the same release settings.
  export CARGO_INCREMENTAL=0 CARGO_PROFILE_RELEASE_DEBUG=0 CUPERTINO_THEME_DIR=/usr/share/cupertino/theme
  local remap target_dir
  target_dir=$(realpath -m "${CARGO_TARGET_DIR:-target}")
  for remap in "--remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase" \
               "--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo" \
               "--remap-path-prefix=$target_dir=/usr/src/debug/$pkgbase/target"; do
    case " ${RUSTFLAGS:-} " in
      *" $remap "*) ;;
      *) RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$remap" ;;
    esac
  done
  export RUSTFLAGS
}

build() {
  cd "cupertino-$pkgver"
  build_environment
  cargo build --frozen --release --workspace --all-features --bins
}

check() {
  cd "cupertino-$pkgver"
  build_environment
  export CUPERTINO_SPEC_DIR="$PWD/data/theme"
  # The compositor tests open a Wayland socket; the build environment has no runtime directory of its own.
  export XDG_RUNTIME_DIR="$srcdir/runtime"
  install -d -m 700 "$XDG_RUNTIME_DIR"
  dbus-run-session -- python3 ci/build-test-fixtures.py --frozen --release -- cargo nextest run --frozen --release --workspace --all-features
  cargo test --frozen --release --workspace --all-features --doc
}

package_cupertino() {
  depends=('glibc' 'sh' 'gcc-libs' 'mesa' 'libglvnd' 'pam' 'systemd' 'dbus>=1.16' 'polkit' 'gnome-keyring' 'libsecret' 'pipewire>=1:1.4' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'xkeyboard-config' 'shared-mime-info' 'adwaita-icon-theme' "cupertino-data>=$pkgver")
  optdepends=('wayland: nested session inside another Wayland desktop'
              'libxkbcommon: nested session'
              'foot: terminal for the nested try-out'
              'iwd: wireless backend when cupertino-netd is enabled'
              'xwayland-satellite>=0.8: X11 app support'
              'xorg-xwayland: X11 app support')
  backup=('etc/cupertino/login.conf' 'etc/cupertino/greeter.json' 'etc/cupertino/compositor.json'
          'etc/pam.d/cupertino-login' 'etc/pam.d/cupertino-session'
          'etc/pam.d/cupertino-greeter' 'etc/pam.d/cupertino-autologin')
  cd "cupertino-$pkgver"
  python3 packaging/release.py install --format arch --package runtime --destdir "$pkgdir" --bindir "${CARGO_TARGET_DIR:-target}/release"
}

package_cupertino-data() {
  pkgdesc='Default asset pack of Cupertino: original icons, Inter and six Unsplash wallpapers'
  arch=('any')
  license=('GPL-3.0-or-later' 'OFL-1.1' 'LicenseRef-Unsplash')
  depends=('adwaita-icon-theme')
  cd "cupertino-$pkgver"
  python3 packaging/release.py install --format arch --package data --destdir "$pkgdir"
}
