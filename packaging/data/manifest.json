{
  "version": 2,
  "name": "Cupertino default",
  "credits": "wallpapers/credits.txt",
  "fonts": {
    "ui": {
      "family": "Inter Variable",
      "files": [
        "fonts/InterVariable-subset.ttf"
      ]
    }
  },
  "icon_theme": {
    "name": "Adwaita",
