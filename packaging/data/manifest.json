  "wallpapers": {
    "default": {
      "light": "wallpapers/trees-covering-snow-W3V2tQAZxPA.jpg",
      "dark": "wallpapers/silhouette-of-mountain-peak-8NuHwPbO62k.jpg"
    }
  }
}
