#!/bin/sh
# The session command: the display manager's Cupertino entry and cupertino-sessiond's session-command run it. When the
# compositor ends, by a crash too, this script ends with its status and the display manager shows its login screen
# again. What happened is a line in ~/.local/state/cupertino/session.log; the compositor's own log is server.log there.
#
# A first run can be bounded: a whole number of seconds in ~/.config/cupertino/session-limit (or $CUPERTINO_SESSION_LIMIT)
# stops the compositor after that long, and an outside `timeout` ends it 30 s later if it hangs instead. No file, no limit.
set -eu
export XDG_CURRENT_DESKTOP=Cupertino

state=${XDG_STATE_HOME:-$HOME/.local/state}/cupertino
config=${XDG_CONFIG_HOME:-$HOME/.config}/cupertino
server=${CUPERTINO_SESSION_SERVER:-/usr/bin/cupertino-server}
mkdir -p "$state" 2>/dev/null || true
# the compositor writes why it ended there (a panic, a lost rendering context, an error); bounded, it ends within seconds
export CUPERTINO_SESSION_END="$state/session-end"
rm -f "$CUPERTINO_SESSION_END" 2>/dev/null || true

# The log is best effort: a state directory that cannot be written must not keep the compositor from starting.
note() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" 2>/dev/null >>"$state/session.log" || true
}

limit=${CUPERTINO_SESSION_LIMIT:-}
if [ -z "$limit" ] && [ -r "$config/session-limit" ]; then
    read -r limit <"$config/session-limit" || true
fi
case $limit in
'') ;;
*[!0-9]*)
    note "ignoring the session limit '$limit': it is not a whole number of seconds"
    limit=
    ;;
esac
while [ "${#limit}" -gt 1 ] && [ "${limit#0}" != "$limit" ]; do
    limit=${limit#0}
done
if [ "${#limit}" -gt 7 ]; then
    note "ignoring the session limit: more than 7 digits"
    limit=
fi

watchdog=
if [ -n "$limit" ] && [ "$limit" -gt 0 ]; then
    set -- --run-for "$limit" "$@"
    watchdog="timeout -k 10 $((limit + 30))"
    note "starting with a limit of $limit s"
else
    note "starting"
fi

# A signal for the session goes to everything in the compositor's session of processes: dbus-run-session ends on TERM
# without passing it on, and the compositor holds the seat and the display until it is gone.
child=
interrupted=
stopped=
forward() {
    if [ -n "$child" ]; then
        pkill -TERM -s "$child" 2>/dev/null || kill -TERM -- "-$child" 2>/dev/null || true
    fi
}
trap 'interrupted=1; stopped=1; forward' TERM INT HUP

# Without a session bus of its own (the display manager provides one), the server gets a fresh one. `setsid` forks only
# when its caller already leads a process group (with or without --wait), and then $! would not lead the session. This
# script runs without job control, so its background job is no group leader and `setsid` runs the program in place: $!
# leads the new session, which is what the signals above are sent to.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    # shellcheck disable=SC2086 # $watchdog is a command and its options, or nothing
    setsid $watchdog "$server" --udev "$@" &
else
    # shellcheck disable=SC2086
    setsid dbus-run-session -- $watchdog "$server" --udev "$@" &
fi
child=$!
# A signal that came before the process was known.
if [ -n "$interrupted" ]; then
    forward
fi

started=$(date +%s)
status=0
wait "$child" || status=$?
# `wait` returns early when a trapped signal arrives; it is repeated for the real status, and once only for each signal
# (a child that is already gone answers 127).
while [ -n "$interrupted" ]; do
    interrupted=
    code=0
    wait "$child" || code=$?
    if [ "$code" -ne 127 ]; then
        status=$code
    fi
done
seconds=$(($(date +%s) - started))

# The session target and the variables the compositor put on a shared user bus (activation_env.rs) end with it.
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet cupertino-session.target 2>/dev/null; then
    systemctl --user stop cupertino-session.target 2>/dev/null || true
    # the defaults the compositor set because the manager had no value of the user's own (activation_env.rs DEFAULTS_RECORD)
    defaults=
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -f "$XDG_RUNTIME_DIR/cupertino-session-defaults" ]; then
        while IFS= read -r name; do
            case "$name" in '' | [!A-Z_]* | *[!A-Z0-9_]*) ;; *) defaults="$defaults $name" ;; esac
        done <"$XDG_RUNTIME_DIR/cupertino-session-defaults"
        rm -f "$XDG_RUNTIME_DIR/cupertino-session-defaults"
    fi
    # shellcheck disable=SC2086 # the names are checked above
    systemctl --user unset-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY XAUTHORITY$defaults 2>/dev/null || true
    note "stopped cupertino-session.target and removed the session's variables from the user manager"
fi

reason=
if [ -f "$CUPERTINO_SESSION_END" ]; then
    reason=$(head -c 512 "$CUPERTINO_SESSION_END" 2>/dev/null | head -n 1 | tr -d '[:cntrl:]') || true
    rm -f "$CUPERTINO_SESSION_END" 2>/dev/null || true
fi

if [ -n "$stopped" ] && [ "$status" -ne 0 ]; then
    note "the compositor was stopped by the session (status $status) after $seconds s"
elif [ -n "$reason" ]; then
    note "the compositor ended with status $status after $seconds s: $reason"
else
    case $status in
    0) note "the compositor ended normally after $seconds s" ;;
    124 | 137) note "the compositor did not stop in time and was ended by the watchdog (status $status) after $seconds s" ;;
    129 | 13[0-9] | 1[4-5][0-9]) note "the compositor was ended by signal $((status - 128)) (status $status) after $seconds s; see server.log" ;;
    *) note "the compositor ended with status $status after $seconds s; see server.log" ;;
    esac
fi
exit "$status"
