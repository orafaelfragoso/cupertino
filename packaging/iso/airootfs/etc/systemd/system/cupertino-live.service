[Unit]
Description=Cupertino live session on tty1
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=live
SupplementaryGroups=video render input audio
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
ExecStart=/usr/bin/cupertino-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
