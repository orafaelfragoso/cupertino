#!/bin/sh
# archive-prune DIR [N]: keep the newest N (default 5) versions of each package in the archive directory DIR and delete
# the older packages with their signatures. Versions are ordered with pacman's vercmp.
set -eu

dir=${1:?usage: archive-prune DIR [N]}
keep=${2:-5}
case $keep in '' | *[!0-9]* | 0) echo 'archive-prune: N is a positive whole number' >&2; exit 2 ;; esac

suffix=-x86_64.pkg.tar.zst
for name in $(ls "$dir" | sed -n "s/^\(.*\)-[^-]*-[0-9][0-9]*$suffix\$/\1/p" | sort -u); do
    case $name in
    *[!A-Za-z0-9@._+-]* | '') echo "archive-prune: skipping the unexpected package name $name" >&2; continue ;;
    esac
    # a regular expression of the name: the characters that are special in one
    pattern=$(printf '%s' "$name" | sed 's/[][\\.*^$/]/\\&/g')
    versions=$(ls "$dir" | sed -n "s/^$pattern-\([^-]*-[0-9][0-9]*\)$suffix\$/\1/p")
    sorted=
    for v in $versions; do
        placed=
        out=
        for s in $sorted; do
            if [ -z "$placed" ] && [ "$(vercmp "$v" "$s")" -gt 0 ]; then
                out="$out $v"
                placed=1
            fi
            out="$out $s"
        done
        [ -n "$placed" ] || out="$out $v"
        sorted=$out
    done
    count=0
    for v in $sorted; do
        count=$((count + 1))
        if [ "$count" -gt "$keep" ]; then
            rm -f "$dir/$name-$v$suffix" "$dir/$name-$v$suffix.sig"
        fi
    done
done
