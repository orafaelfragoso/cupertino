# Sourced by the scripts that build or run tests, so that they take turns on this machine: parallel builds and test
# runs from several checkouts (worktrees) overload it, which makes timed tests fail and every run slower. The first
# holds a machine-wide lock; the others wait for it and say so. Nested scripts (scripts/done running scripts/test)
# share the lock of the outer one.
#   . scripts/dev/heavy-lock; heavy_lock NAME "$0" "$@"     run the rest of the script under the lock
# CUPERTINO_HEAVY_LOCK=0 runs without it.
heavy_lock() {
    name=$1
    shift
    if [ "${CUPERTINO_HEAVY_LOCK:-}" = 0 ] || [ -n "${CUPERTINO_HEAVY_LOCK_HELD:-}" ] || ! command -v flock >/dev/null; then
        return 0
    fi
    lock="${XDG_RUNTIME_DIR:-/tmp}/cupertino-heavy-jobs.lock"
    export CUPERTINO_HEAVY_LOCK_HELD=1
    if ! flock -n "$lock" true 2>/dev/null; then
        echo "$name: waiting for another build or test run on this machine to finish" >&2
    fi
    exec flock "$lock" "$@"
}
