#!/usr/bin/env python3
"""Memory and CPU of every desktop process in one headless session, at rest and while used.

    scripts/dev/measure                 the release build of this checkout (built first)
    scripts/dev/measure --out F.json    also write the figures as JSON
    scripts/dev/measure --compare A.json B.json
                                        the change from one measurement to another, process by process
    NO_BUILD=1 scripts/dev/measure      measure what target/release holds
    MEASURE_BIN=DIR scripts/dev/measure measure the programs in DIR (a copy of an earlier build), without building

The session runs at 1512 x 982 pixels, scale 2, with Files and Settings open. After it starts it is left alone for a
while (rest), then used: the launcher opens and a search is typed, the pointer sweeps along the dock and over the
windows, the launcher closes (use). Then it rests again (rest after use). For each program it reports:
  pss       proportional memory at the end, in MiB (shared pages split between the processes that map them)
  rss       resident memory at the end, in MiB
  private   private dirty memory at the end, in MiB: written pages no other process shares, what the program alone
            costs (heap, its own buffers, a driver's private allocations)
  cpu rest  CPU per second of the first rest, in percent of one core
  cpu use   CPU per second of the use
  cpu after CPU per second of the rest after use: an animation or timer left running shows here
Each figure is the median of RUNS sessions (default 3; set RUNS to change it).
"""
import json
import os
import pathlib
import statistics
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
TICK = os.sysconf("SC_CLK_TCK")
SIZE = (1512, 982)
SCALE = 2
LOGICAL = (SIZE[0] // SCALE, SIZE[1] // SCALE)
# seconds from the server's start
SETTLE = 8.0
REST = (8.0, 14.0)
USE = (14.0, 22.0)
AFTER = (23.0, 29.0)
END = 30.0


def script() -> list[str]:
    w, h = LOGICAL
    dock_y = h - 30
    flags = ["--spawn", "cupertino-files", "--spawn", "cupertino-settings",
             "--action", f"{USE[0] + 0.2}:launcher", "--type", f"{USE[0] + 1.0}:term"]
    t = USE[0] + 2.0
    flags += ["--key", f"{t}:Escape"]
    # the pointer sweeps along the dock and back, then over the windows
    steps = 40
    for i in range(steps + 1):
        x = round(w * 0.25 + (w * 0.5) * i / steps)
        flags += ["--pointer", f"{t + 0.3 + i * 0.05:.2f}:{x},{dock_y}"]
    t += 0.3 + steps * 0.05
    for i in range(steps + 1):
        x = round(w * 0.75 - (w * 0.5) * i / steps)
        flags += ["--pointer", f"{t + i * 0.05:.2f}:{x},{dock_y}"]
    t += steps * 0.05
    for i in range(20):
        flags += ["--pointer", f"{t + i * 0.05:.2f}:{round(w * 0.2 + i * 20)},{round(h * 0.4)}"]
    flags += ["--pointer", f"{USE[1] - 0.5}:{w - 1},{h - 1}"]
    return flags


def children(pid: int) -> list[int]:
    out = []
    for task in pathlib.Path(f"/proc/{pid}/task").glob("*"):
        try:
            out += [int(c) for c in (task / "children").read_text().split()]
        except OSError:
            pass
    return out


def tree(pid: int) -> list[int]:
    seen, todo = [], [pid]
    while todo:
        p = todo.pop()
        seen.append(p)
        todo += children(p)
    return seen


def name(pid: int) -> str:
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return ""
    return pathlib.Path(exe).name


def cpu(pid: int) -> int:
    try:
        f = pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return int(f[11]) + int(f[12])
    except (OSError, IndexError):
        return 0


def memory(pid: int) -> tuple[float, float, float]:
    """Pss, Rss and private dirty memory of `pid`, in MiB."""
    pss = rss = private = 0.0
    try:
        for line in pathlib.Path(f"/proc/{pid}/smaps_rollup").read_text().splitlines():
            if line.startswith("Pss:"):
                pss = int(line.split()[1]) / 1024
            elif line.startswith("Rss:"):
                rss = int(line.split()[1]) / 1024
            elif line.startswith("Private_Dirty:"):
                private = int(line.split()[1]) / 1024
    except OSError:
        pass
    return pss, rss, private


def sample(root: int) -> dict[str, dict]:
    by = {}
    for p in tree(root):
        n = name(p)
        if not n.startswith("cupertino") or n.endswith(".sh"):
            continue
        e = by.setdefault(n, {"cpu": 0, "pss": 0.0, "rss": 0.0, "private": 0.0, "procs": 0})
        e["cpu"] += cpu(p)
        pss, rss, private = memory(p)
        e["pss"] += pss
        e["rss"] += rss
        e["private"] += private
        e["procs"] += 1
    return by


def one_run(bin_dir: pathlib.Path) -> dict[str, dict]:
    env = dict(os.environ, BIN_DIR=str(bin_dir), SIZE=f"{SIZE[0]}x{SIZE[1]}",
               SYSTEM_DATA_DIRS=f"{pathlib.Path.home()}/.local/share:/usr/local/share:/usr/share")
    with tempfile.TemporaryDirectory() as tmp:
        out = pathlib.Path(tmp) / "end.png"
        args = [str(ROOT / "crates/cupertino-server/scripts/session.sh"), "--screenshot", str(out),
                "--screenshot-after", str(END), "--exit-after-screenshot", "--pointer",
                f"0:{LOGICAL[0] - 1},{LOGICAL[1] - 1}", *script(), "--scale", str(SCALE), "--appearance", "dark"]
        proc = subprocess.Popen(args, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                start_new_session=True)
        start = time.monotonic()
        marks = {}
        for label, at in (("rest0", REST[0]), ("rest1", REST[1]), ("use1", USE[1]), ("after0", AFTER[0]),
                          ("after1", AFTER[1])):
            time.sleep(max(0.0, start + at - time.monotonic()))
            marks[label] = (time.monotonic(), sample(proc.pid))
        proc.wait(timeout=60)
    result = {}
    names = set(marks["after1"][1])
    for n in names:
        def rate(a: str, b: str) -> float:
            (ta, sa), (tb, sb) = marks[a], marks[b]
            if n not in sa or n not in sb:
                return float("nan")
            return 100.0 * (sb[n]["cpu"] - sa[n]["cpu"]) / TICK / (tb - ta)
        end = marks["after1"][1][n]
        result[n] = {"pss": end["pss"], "rss": end["rss"], "private": end["private"], "procs": end["procs"],
                     "cpu rest": rate("rest0", "rest1"), "cpu use": rate("rest1", "use1"),
                     "cpu after": rate("after0", "after1")}
    return result


FIELDS = ["pss", "rss", "private", "cpu rest", "cpu use", "cpu after"]
MEMORY_FIELDS = 3


def median(runs: list[dict[str, dict]]) -> dict[str, dict]:
    names = sorted(set().union(*runs))
    out = {}
    for n in names:
        out[n] = {}
        for f in FIELDS:
            vals = [r[n][f] for r in runs if n in r and r[n][f] == r[n][f]]
            out[n][f] = round(statistics.median(vals), 2) if vals else None
    total = {f: round(sum(v[f] or 0 for v in out.values()), 2) for f in FIELDS}
    out["TOTAL"] = total
    return out


def table(m: dict[str, dict]) -> str:
    lines = [f"{'program':34} {'pss MiB':>8} {'rss MiB':>8} {'priv MiB':>8} {'cpu rest%':>9} {'cpu use%':>9} "
             f"{'cpu after%':>10}"]
    for n, v in m.items():
        cells = [f"{v[f]:8.1f}" if v.get(f) is not None else "       -" for f in FIELDS[:MEMORY_FIELDS]]
        cells += [f"{v[f]:9.1f}" if v.get(f) is not None else "        -" for f in FIELDS[MEMORY_FIELDS:]]
        lines.append(f"{n:34} " + " ".join(cells))
    return "\n".join(lines)


def compare(a: dict, b: dict) -> str:
    lines = [f"{'program':34} " + " ".join(f"{f:>16}" for f in FIELDS)]
    for n in sorted(set(a) | set(b), key=lambda k: (k == "TOTAL", k)):
        cells = []
        for f in FIELDS:
            x, y = (a.get(n) or {}).get(f), (b.get(n) or {}).get(f)
            cells.append(f"{x if x is not None else '-':>7}->{y if y is not None else '-':<8}")
        lines.append(f"{n:34} " + " ".join(cells))
    return "\n".join(lines)


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["--compare"]:
        a, b = (json.loads(pathlib.Path(p).read_text()) for p in args[1:3])
        print(compare(a, b))
        return 0
    bin_dir = pathlib.Path(os.environ.get("MEASURE_BIN", ROOT / "target/release"))
    if not os.environ.get("NO_BUILD") and "MEASURE_BIN" not in os.environ:
        subprocess.run([str(ROOT / "scripts/dev/build")], check=True)
    runs = [one_run(bin_dir) for _ in range(int(os.environ.get("RUNS", "3")))]
    m = median(runs)
    print(table(m))
    if "--out" in args:
        pathlib.Path(args[args.index("--out") + 1]).write_text(json.dumps(m, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
