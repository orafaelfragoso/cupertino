#!/usr/bin/env python3
"""Instruction counts of the hot functions, under Valgrind's Callgrind: the same on a loaded machine as on an idle one.

    scripts/dev/microbench                       every crate's `instructions` bench (benches/instructions.rs)
    scripts/dev/microbench raster-math glass     only these crates (the `cupertino-` prefix may be left off)
    scripts/dev/microbench --save-baseline main  keep this run's counts as the baseline `main`
    scripts/dev/microbench --baseline main       compare with the baseline `main`; fail when a count rises by more than
                                                 --limit percent (default 3), the framework's own regression check
    scripts/dev/microbench --checkout DIR ...    the benches of another checkout of the repository (another commit),
                                                 built into this checkout's target directory, so that the baselines
                                                 of both are kept in one place and compared with each other
    scripts/dev/microbench --summary FILE        also append the table of counts to FILE, in Markdown
    scripts/dev/microbench --among PACKAGES      only the crates also in PACKAGES (a JSON list or comma-separated)
    scripts/dev/microbench --list                print the crates it would bench, as a JSON list, and run nothing
    scripts/dev/microbench ... -- ARGS           ARGS go to the framework's runner (`--callgrind-metrics=@all`, say)

The benches are library benchmarks of the gungraun crate. They run through its runner, `gungraun-runner`, which must be
the version of the library in Cargo.lock exactly: the script takes GUNGRAUN_RUNNER or the one on PATH if it is that
version, otherwise the copy it installed in target/gungraun-runner/VERSION, and it installs that copy with
`cargo install` when there is none. MICROBENCH_RUNNER_ROOT=DIR keeps one runner in DIR/bin instead, replaced when the
version changes (CI keeps it in the cached cargo home). Valgrind must be installed.

The counts are kept under target/gungraun (GUNGRAUN_HOME moves them). A benchmark with no saved baseline of the name
asked is new: it is counted and kept as that baseline, and there is nothing to compare it with.
"""
import argparse
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
# the bench target every crate names its instruction-count benches by
BENCH = "instructions"
# how much, in percent, an instruction count may rise over its baseline before the run fails
DEFAULT_LIMIT = 3.0
PREFIX = "cupertino-"


def bench_crates(root: pathlib.Path) -> list[str]:
    """The crates under `root`/crates that declare a `[[bench]]` target named `instructions`, by package name."""
    found = []
    for manifest in sorted((root / "crates").glob("*/Cargo.toml")):
        text = manifest.read_text()
        package = re.search(r'^\[package\][^\[]*?^name\s*=\s*"([^"]+)"', text, re.M | re.S)
        benches = re.findall(r'^\[\[bench\]\][^\[]*?^name\s*=\s*"([^"]+)"', text, re.M | re.S)
        if package and BENCH in benches:
            found.append(package.group(1))
    return found


def select(asked: list[str], available: list[str]) -> list[str]:
    """The crates `asked` for, by package name with or without the prefix; all `available` when none are asked."""
    if not asked:
        return list(available)
    chosen, unknown = [], []
    for name in asked:
        full = name if name.startswith(PREFIX) else PREFIX + name
        if full in available:
            if full not in chosen:
                chosen.append(full)
        else:
            unknown.append(name)
    if unknown:
        raise SystemExit(f"microbench: no {BENCH} bench in {', '.join(unknown)} (there are: {', '.join(available)})")
    return chosen


def among(crates: list[str], packages: str | None) -> list[str]:
    """`crates` that are also in `packages`, a JSON list or a comma-separated one (all of them when it is None)."""
    if packages is None:
        return list(crates)
    packages = packages.strip()
    names = json.loads(packages) if packages.startswith("[") else [p.strip() for p in packages.split(",")]
    return [c for c in crates if c in set(names)]


def library_version(lock: pathlib.Path) -> str | None:
    """The version of the gungraun library in `lock`, or None when nothing depends on it."""
    if not lock.exists():
        return None
    for block in lock.read_text().split("[[package]]"):
        name = re.search(r'^name\s*=\s*"([^"]+)"', block, re.M)
        version = re.search(r'^version\s*=\s*"([^"]+)"', block, re.M)
        if name and version and name.group(1) == "gungraun":
            return version.group(1)
    return None


def runner_version(path: str) -> str | None:
    """The version `path --version` reports, or None when it does not run."""
    try:
        out = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"gungraun-runner\s+(\S+)", out)
    return match.group(1) if match else None


def runner_root(version: str, target: pathlib.Path, env: dict) -> pathlib.Path:
    """Where the runner of `version` is installed: MICROBENCH_RUNNER_ROOT (one runner, replaced when the version
    changes), else a directory of its own per version in the target directory."""
    root = env.get("MICROBENCH_RUNNER_ROOT")
    return pathlib.Path(root) if root else target / "gungraun-runner" / version


def find_runner(version: str, target: pathlib.Path, env: dict, install: bool = True) -> str:
    """The path of a runner of exactly `version`: GUNGRAUN_RUNNER, the one on PATH, or the one kept in its root,
    installed there when it is not that version."""
    root = runner_root(version, target, env)
    kept = root / "bin" / "gungraun-runner"
    for path in [env.get("GUNGRAUN_RUNNER"), shutil.which("gungraun-runner", path=env.get("PATH")), str(kept)]:
        if path and runner_version(path) == version:
            return path
    if not install:
        raise SystemExit(f"microbench: no gungraun-runner {version}")
    print(f"microbench: installing gungraun-runner {version} into {root}", file=sys.stderr)
    subprocess.run(["cargo", "install", "gungraun-runner", "--version", f"={version}", "--locked", "--force",
                    "--root", str(root)], check=True)
    if runner_version(str(kept)) != version:
        raise SystemExit(f"microbench: {kept} is not gungraun-runner {version}")
    return str(kept)


def runner_args(baseline: str | None, save_baseline: str | None, limit: float, extra: list[str]) -> list[str]:
    """What the benches' runner is given: JSON lines on stdout, the baselines, and the limit when comparing."""
    args = ["--output-format=json"]
    if baseline:
        args += [f"--baseline={baseline}", f"--callgrind-limits=ir={limit:g}%"]
    if save_baseline:
        args.append(f"--save-baseline={save_baseline}")
    return args + extra


def cargo_command(crates: list[str], args: list[str]) -> list[str]:
    command = ["cargo", "bench", "--locked", "--no-fail-fast"]
    for crate in crates:
        command += ["-p", crate]
    return command + ["--bench", BENCH, "--"] + args


def readings(lines: list[str]) -> list[dict]:
    """One reading per benchmark from the runner's JSON lines: its name, its instructions now and in the baseline (None
    when it has none) and whether the runner found it regressed."""
    out = []
    for line in lines:
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            summary = json.loads(line)
        except json.JSONDecodeError:
            continue
        name = summary.get("module_path", "?")
        if summary.get("id"):
            name += f" {summary['id']}"
        package = pathlib.PurePath(summary.get("package_dir") or "").name
        for profile in summary.get("profiles") or []:
            if profile.get("tool") != "Callgrind":
                continue
            total = (profile.get("data") or {}).get("total") or {}
            values = ((total.get("metrics") or {}).get("Ir") or {}).get("values") or {}
            out.append({"crate": package, "name": name, "new": values.get("new"), "old": values.get("old"),
                        "regressed": bool(total.get("regressions"))})
    return out


def change(reading: dict) -> float | None:
    """The change of the instructions over the baseline in percent, None when there is no baseline."""
    new, old = reading["new"], reading["old"]
    if new is None or old is None:
        return None
    if old == 0:
        return 0.0 if new == 0 else float("inf")
    return (new - old) * 100.0 / old


def table(rows: list[dict], markdown: bool = False) -> str:
    def cells(r):
        c = change(r)
        old = "new" if r["old"] is None else f"{r['old']:,}"
        diff = "" if c is None else f"{c:+.2f}%"
        flag = "REGRESSED" if r["regressed"] else ""
        return [r["crate"], r["name"], f"{r['new']:,}" if r["new"] is not None else "?", old, diff, flag]

    head = ["crate", "benchmark", "instructions", "baseline", "change", ""]
    body = [cells(r) for r in rows]
    if markdown:
        lines = ["| " + " | ".join(head[:5]) + " |", "|---|---|---:|---:|---:|"]
        for c in body:
            mark = " **regressed**" if c[5] else ""
            lines.append("| " + " | ".join(c[:4]) + f" | {c[4]}{mark} |")
        return "\n".join(lines) + "\n"
    widths = [max(len(row[i]) for row in [head] + body) for i in range(len(head))]
    right = {2, 3, 4}
    fmt = lambda row: "  ".join(v.rjust(w) if i in right else v.ljust(w) for i, (v, w) in enumerate(zip(row, widths)))
    return "\n".join(fmt(row).rstrip() for row in [head] + body) + "\n"


def main(argv: list[str]) -> int:
    extra = []
    if "--" in argv:
        at = argv.index("--")
        argv, extra = argv[:at], argv[at + 1:]
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("crates", nargs="*", help="crates to bench (default: every crate with an instructions bench)")
    parser.add_argument("--save-baseline", metavar="NAME", help="keep this run's counts as the baseline NAME")
    parser.add_argument("--baseline", metavar="NAME", help="compare with the baseline NAME")
    parser.add_argument("--limit", type=float, default=DEFAULT_LIMIT, metavar="PERCENT",
                        help=f"the rise over the baseline that fails the run (default {DEFAULT_LIMIT:g})")
    parser.add_argument("--checkout", type=pathlib.Path, metavar="DIR",
                        help="bench another checkout of the repository, into this checkout's target directory")
    parser.add_argument("--summary", type=pathlib.Path, metavar="FILE", help="append the table to FILE in Markdown")
    parser.add_argument("--among", metavar="PACKAGES",
                        help="only the crates also in PACKAGES (a JSON list or comma-separated): CI's affected crates")
    parser.add_argument("--list", action="store_true", help="print the crates that would be benched as a JSON list")
    args = parser.parse_args(argv)

    source = (args.checkout or ROOT).resolve()
    available = bench_crates(source)
    crates = among(select(args.crates, available), args.among)
    if args.list:
        print(json.dumps(crates))
        return 0
    if not crates:
        print(f"microbench: no {BENCH} benches to run in {source}")
        return 0
    if shutil.which("valgrind") is None:
        raise SystemExit("microbench: valgrind is not installed (pacman -S valgrind)")
    version = library_version(source / "Cargo.lock")
    if version is None:
        raise SystemExit(f"microbench: {source}/Cargo.lock has no gungraun")
    target = pathlib.Path(os.environ.get("CARGO_TARGET_DIR") or ROOT / "target").resolve()
    env = dict(os.environ, CARGO_TARGET_DIR=str(target))
    env["GUNGRAUN_RUNNER"] = find_runner(version, target, env)
    env.setdefault("GUNGRAUN_HOME", str(target / "gungraun"))

    command = cargo_command(crates, runner_args(args.baseline, args.save_baseline, args.limit, extra))
    print("microbench: " + " ".join(command), file=sys.stderr)
    proc = subprocess.Popen(command, cwd=source, env=env, stdout=subprocess.PIPE, text=True)
    lines = []
    for line in proc.stdout:
        lines.append(line)
        if not line.lstrip().startswith("{"):
            sys.stdout.write(line)
    status = proc.wait()

    rows = readings(lines)
    print()
    print(table(rows), end="", flush=True)
    if args.summary:
        with args.summary.open("a") as f:
            label = (f" against `{args.baseline}`" if args.baseline
                     else f" saved as `{args.save_baseline}`" if args.save_baseline else "")
            if args.checkout:
                label += f" ({source.name})"
            f.write(f"\n### Instruction counts{label}\n\n" + table(rows, markdown=True))
    regressed = [r["name"] for r in rows if r["regressed"]]
    if regressed:
        print(f"\nmicrobench: {len(regressed)} rose by more than {args.limit:g}% over {args.baseline}: "
              + ", ".join(regressed), file=sys.stderr)
    if status != 0 and not regressed:
        print(f"microbench: cargo bench failed ({status})", file=sys.stderr)
    return 1 if status != 0 or regressed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
