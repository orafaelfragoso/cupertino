#!/usr/bin/env python3
"""The quick performance check after a merge: the bench's scenarios the change can affect, compared with this machine's
baseline, and where the time went when one regressed.

    scripts/dev/perf-gate [BASE]            the scenarios of the crates changed in BASE..HEAD, one run each
    scripts/dev/perf-gate --update-baseline record the baseline: every scenario the table below names, three runs each
    scripts/dev/perf-gate --scenario a,b    these scenarios, whatever changed

BASE defaults to the last commit that passed, kept in target/bench/baseline/last-pass, else origin/main. The changed
crates and every crate that depends on them (ci/affected.py's graph; a changed manifest, lock file or shared input
selects them all) name the scenarios through SCENARIOS. Every run is at 3840 x 2160, scale 1.5, compared with
target/bench/baseline/HOSTNAME-3840x2160-1.5.json by `scripts/dev/bench --compare`'s rules. On a regression each
regressed scenario runs once more under perf (`scripts/dev/bench --profile=perf`), and the top functions of each
regressed program are printed from its summary; the gate then exits 1. A pass records HEAD as the last commit that
passed.
"""
import argparse
import dataclasses
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import shutil
import socket
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
SIZE, SCALE = "3840x2160", 1.5
BASELINE_DIR = ROOT / "target/bench/baseline"
LAST_PASS = BASELINE_DIR / "last-pass"
BASELINE_RUNS = 3
# how many lines of a regressed program's summary are printed: its top functions by self and by inclusive time
SHOWN = 15

EVERY = ("idle", "drag", "hover", "resize", "control-panel", "launcher-typing", "files-scroll", "dock-sweep",
         "overview", "launcher", "context-menu", "files-full-repaint", "files-full-scroll")
# The scenarios a change to each program (or a crate it is built from, through the crate graph) can move. The server
# and the glass are in every frame; every program that runs in the session also wakes at idle.
SCENARIOS = {
    "cupertino-server": EVERY,
    "cupertino-glass": EVERY,
    "cupertino-files": ("files-scroll", "resize", "files-full-repaint", "files-full-scroll", "context-menu", "drag",
                        "idle"),
    "cupertino-settings": ("drag", "hover", "idle"),
    "cupertino-launcher": ("launcher", "launcher-typing", "idle"),
    "cupertino-controlcenter": ("control-panel", "idle"),
    "cupertino-menubar": ("control-panel", "drag", "idle"),
    "cupertino-dock": ("dock-sweep", "idle"),
    "cupertino-overview": ("overview",),
    "cupertino-windowmanager": ("drag", "resize", "hover", "overview", "idle"),
    "cupertino-decorations": ("drag", "hover", "resize"),
    "cupertino-notifications": ("idle",),
    "cupertino-osd": ("idle",),
}


def load(name: str, path: pathlib.Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


bench = load("bench", ROOT / "scripts/dev/bench")
affected = load("affected", ROOT / "ci/affected.py")


def scenarios_for(crates: list[str]) -> list[str]:
    """The scenarios the crates can move, in the bench's order."""
    wanted = {s for c in crates for s in SCENARIOS.get(c, ())}
    return [s for s in EVERY if s in wanted]


# files no program is built from: tests, the tests' and CI's configuration, scripts and documentation
NOT_BUILT = (".config/", ".github/", "ci/", "scripts/", "docs/", ".agents/", ".claude/", ".codex/")
NOT_BUILT_IN_CRATES = ("tests", "benches", "examples")
# the one packaging file the bench's sessions read: which shell processes start
SESSION_CONFIG = "packaging/files/etc/cupertino/compositor.json"


def built_from(path: str) -> bool:
    """Whether a program of the session can change with `path`."""
    parts = path.split("/")
    if path.startswith(NOT_BUILT) or path.endswith(".md"):
        return False
    if parts[0] == "packaging":
        return path == SESSION_CONFIG
    return not (parts[0] == "crates" and len(parts) > 3 and parts[2] in NOT_BUILT_IN_CRATES)


def crates_changed(packages: list, changed: list[str]) -> list[str]:
    """The crates the changed files are in and every crate that depends on them, by their dependencies alone: the
    server's tests launching every program is not a dependency of the server's code. A changed manifest, lock file or
    other shared input selects every crate."""
    plain = [dataclasses.replace(p, executable=False) for p in packages]
    return affected.affected(plain, [p for p in changed if built_from(p)])


def git(*args: str) -> str:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=True).stdout.strip()


def baseline_path() -> pathlib.Path:
    return BASELINE_DIR / f"{socket.gethostname()}-{SIZE}-{SCALE:g}.json"


def base_commit(given: str | None) -> str:
    if given:
        return given
    try:
        last = LAST_PASS.read_text().strip()
        if last:
            git("cat-file", "-e", f"{last}^{{commit}}")
            return last
    except (OSError, subprocess.CalledProcessError):
        pass
    return "origin/main"


def run_bench(scenarios: list[str], runs: int, out: pathlib.Path, *extra: str) -> int:
    args = [sys.executable, str(ROOT / "scripts/dev/bench"), "--size", SIZE, "--scale", f"{SCALE:g}",
            "--runs", str(runs), "--scenario", ",".join(scenarios), "--out", str(out), *extra]
    return subprocess.run(args, cwd=ROOT).returncode


def summary_lines(text: str, shown: int = SHOWN) -> str:
    """A summary's heading, and the first `shown` rows of its self-time and inclusive-time tables."""
    out, left = [], 0
    for line in text.splitlines():
        if line.startswith(("== ", "   perf report")):
            out.append(line)
        elif line.startswith("top ") and "functions by" in line:
            out += ["", line]
            left = shown + 1  # and the columns' titles
        elif left and line.strip():
            out.append(line)
            left -= 1
        else:
            left = 0
    return "\n".join(out)


def where_the_time_went(rows: list[dict]) -> None:
    """Each regressed scenario once more under perf, and the summary of each regressed program."""
    regressed: dict[str, set[str]] = {}
    for r in rows:
        if r["verdict"] == "regression":
            scenario = r["scenario"].split(" Hz ", 1)[-1]
            regressed.setdefault(scenario, set()).add(r["program"])
    tools = bench.load_profile_tools()
    for scenario, programs in regressed.items():
        folder = ROOT / "target/bench/perf-gate-profile" / scenario
        print(f"\nperf-gate: {scenario} regressed; profiling it under perf (summary in {folder})", flush=True)
        shutil.rmtree(folder, ignore_errors=True)
        status = run_bench([scenario], 1, ROOT / "target/bench/perf-gate-profile" / f"{scenario}.json",
                           "--profile=perf", "--profile-out", str(folder))
        entries = [e for d in sorted(folder.glob("*")) if d.is_dir() for e in tools.read_index(d)]
        if status not in (0, 1) or not entries:
            print(f"perf-gate: the profiled run of {scenario} failed ({status})")
            continue
        for program in sorted(programs):
            found = [e for e in entries if e["program"] == program]
            if not found:
                print(f"perf-gate: {program} has no samples in the profile of {scenario}")
            for e in found:
                print()
                print(summary_lines(pathlib.Path(e["summary"]).read_text()))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("base", nargs="?")
    ap.add_argument("--update-baseline", action="store_true")
    ap.add_argument("--scenario")
    args = ap.parse_args()
    os.chdir(ROOT)
    stored = baseline_path()
    head = git("rev-parse", "HEAD")
    if args.update_baseline:
        scenarios = args.scenario.split(",") if args.scenario else scenarios_for(list(SCENARIOS))
        print(f"perf-gate: recording the baseline, {BASELINE_RUNS} runs of {', '.join(scenarios)}", flush=True)
        status = run_bench(scenarios, BASELINE_RUNS, stored)
        if status == 0:
            LAST_PASS.write_text(head + "\n")
            print(f"perf-gate: baseline of {head[:12]} in {stored}")
        return status
    if args.scenario:
        scenarios = args.scenario.split(",")
    else:
        base = base_commit(args.base)
        changed = [p for p in git("diff", "--name-only", f"{base}..HEAD").splitlines() if p]
        crates = crates_changed(affected.workspace(), changed)
        scenarios = scenarios_for(crates)
        print(f"perf-gate: {base[:12]}..HEAD changes {len(changed)} files; the scenarios they can move: "
              f"{', '.join(scenarios) or 'none'}", flush=True)
        if not scenarios:
            LAST_PASS.parent.mkdir(parents=True, exist_ok=True)
            LAST_PASS.write_text(head + "\n")
            return 0
    if not stored.exists():
        print(f"perf-gate: no baseline for this machine at {stored}; record one with "
              "scripts/dev/perf-gate --update-baseline", file=sys.stderr)
        return 2
    baseline = json.loads(stored.read_text())
    missing = [s for s in scenarios if s not in baseline["config"]["scenarios"]]
    if missing:
        print(f"perf-gate: the baseline lacks {', '.join(missing)}; record it again with --update-baseline",
              file=sys.stderr)
        return 2
    current = ROOT / "target/bench/perf-gate-current.json"
    status = run_bench(scenarios, 1, current)
    if status != 0:
        print(f"perf-gate: the bench failed ({status})", file=sys.stderr)
        return status
    rows, notes = bench.compare(baseline["summary"], json.loads(current.read_text())["summary"])
    print()
    print(bench.comparison_table(rows, notes))
    if any(r["verdict"] == "regression" for r in rows):
        where_the_time_went(rows)
        print("\nperf-gate: failed: the regressions are above, and where the regressed programs spend their time")
        return 1
    LAST_PASS.write_text(head + "\n")
    print(f"perf-gate: passed; {head[:12]} is the last commit that passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
