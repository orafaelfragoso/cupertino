#!/bin/sh
# Gives a fresh git worktree a warm Cargo target directory: a copy-on-write clone of the main checkout's
# `target/debug`, so the worktree's first build reuses every dependency the main checkout has compiled instead of
# starting cold. The clone shares the main checkout's blocks until either side rewrites a file, so it costs no disk
# at first. Needs a filesystem with reflinks (btrfs, XFS); elsewhere it says so and does nothing.
#
#   scripts/dev/warm-target            run from inside the worktree
#
# The worktree's own crates still rebuild once, since their paths differ from the main checkout's.
set -eu

here=$(git rev-parse --show-toplevel)
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
if [ "$here" = "$main" ]; then
    echo 'warm-target: this is the main checkout; nothing to do'
    exit 0
fi
if [ ! -d "$main/target/debug" ]; then
    echo "warm-target: $main/target/debug does not exist yet; build there first"
    exit 0
fi
if [ -e "$here/target/debug" ]; then
    echo 'warm-target: this worktree already has target/debug; left as it is'
    exit 0
fi
mkdir -p "$here/target"
if cp -a --reflink=always "$main/target/debug" "$here/target/debug" 2>/dev/null; then
    echo "warm-target: cloned $main/target/debug"
else
    rm -rf "$here/target/debug"
    echo 'warm-target: this filesystem cannot clone files; the first build starts cold'
fi
