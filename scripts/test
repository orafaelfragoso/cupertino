#!/usr/bin/env python3
"""Run the tests, within budget.

    scripts/test                 the fast tier of the crates changed since origin/main (committed or not) and of the
                                 crates that depend on them
    scripts/test --all           the fast tier of the whole workspace
    scripts/test --slow          the slow tier (processes, sockets, GPU, soak): CI runs it; run it when you touch one
    scripts/test -p CRATE..      the fast tier of the crates named
    scripts/test ... -- ARGS     ARGS go to nextest (a filter, say: -- -E 'test(/dock/)')

The fast tier must finish in 5 minutes for the whole workspace, and each of its tests in 2 seconds. A test over that
budget fails the run with its name and time: make it faster (the test clock, not sleeps), or move it to the slow tier in
.config/nextest.toml with a reason. The 20 slowest tests are printed after every run.
"""
import os
import pathlib
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "ci"))
import affected  # noqa: E402

TEST_BUDGET = 2.0  # seconds, each test of the fast tier
RUN_BUDGET = 300.0  # seconds, the whole fast tier's run


def changed() -> list[str]:
    base = subprocess.run(["git", "merge-base", "HEAD", "origin/main"], cwd=ROOT, capture_output=True, text=True)
    base = base.stdout.strip() or "HEAD"
    out = subprocess.check_output(["git", "diff", "--name-only", "--no-renames", base], cwd=ROOT, text=True).split()
    out += subprocess.check_output(["git", "ls-files", "--others", "--exclude-standard"], cwd=ROOT, text=True).split()
    return sorted(set(out))


def main() -> int:
    args = sys.argv[1:]
    passthrough = []
    if "--" in args:
        i = args.index("--")
        args, passthrough = args[:i], args[i + 1:]
    profile = "slow" if "--slow" in args else "default"
    packages = [args[i + 1] for i, a in enumerate(args) if a == "-p" and i + 1 < len(args)]
    workspace = affected.workspace()
    if "--all" in args or profile == "slow":
        packages = []
        scope = ["--workspace"]
    else:
        if not packages:
            paths = changed()
            packages = affected.affected(workspace, paths) if paths else []
            if not packages:
                print("scripts/test: nothing changed since origin/main; --all runs everything")
                return 0
        scope = [o for p in packages for o in ("-p", p)]
    fixtures = affected.fixture_packages(workspace, packages) if packages else None
    command = ["cargo", "nextest", "run", "--locked", "--all-features", "--profile", profile, *scope, *passthrough]
    if fixtures is not None or not packages:
        opts = [o for p in (fixtures or []) for o in ("--package", p)]
        command = [sys.executable, str(ROOT / "ci" / "build-test-fixtures.py"), "--locked", *opts, "--", *command]
    print("scripts/test:", " ".join(scope if len(scope) < 12 else scope[:12] + ["..."]), flush=True)
    started = time.monotonic()
    status = subprocess.run(command, cwd=ROOT).returncode
    total = time.monotonic() - started
    return report(profile, total, status, whole=not packages)


def report(profile: str, total: float, status: int, whole: bool) -> int:
    junit = ROOT / "target" / "nextest" / profile / "junit.xml"
    if not junit.exists():
        return status
    tree = ET.parse(junit)
    run_time = float(tree.getroot().get("time", "0"))
    cases = []
    for suite in tree.getroot().iter("testsuite"):
        for case in suite.iter("testcase"):
            cases.append((float(case.get("time", "0")), f'{suite.get("name")} {case.get("name")}'))
    cases.sort(reverse=True)
    print(f"\nslowest tests ({len(cases)} run, tests took {run_time:.0f} s, {total:.0f} s with the build):")
    for t, name in cases[:20]:
        print(f"  {t:7.2f} s  {name}")
    if profile != "default":
        return status
    over = [(t, n) for t, n in cases if t > TEST_BUDGET]
    for t, name in over:
        print(f"OVER BUDGET: {name} took {t:.2f} s (budget {TEST_BUDGET:.0f} s): speed it up or move it to the slow tier",
              file=sys.stderr)
    if whole and run_time > RUN_BUDGET:
        print(f"OVER BUDGET: the fast tier took {run_time:.0f} s (budget {RUN_BUDGET:.0f} s)", file=sys.stderr)
        return status or 1
    return status or (1 if over else 0)


if __name__ == "__main__":
    sys.exit(main())
