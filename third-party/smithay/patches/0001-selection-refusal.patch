+
+/// Ask the handler whether a client may set the selection to `source`, and cancel the source when it may not.
+pub(crate) fn refused<D: SelectionHandler>(
+    handler: &mut D,
+    ty: SelectionTarget,
+    source: Option<&SelectionSourceProvider>,
+    seat: &Seat<D>,
+) -> bool {
+    let Some(provider) = source else {
+        return false;
+    };
+    let source = SelectionSource {
+        provider: provider.clone(),
+    };
+    if handler.allow_selection(ty, &source, seat) {
+        return false;
+    }
+    provider.cancel();
+    true
 }
 
 /// The target for the selection request.
